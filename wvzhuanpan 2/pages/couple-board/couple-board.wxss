.page {
  min-height: 100vh;
  padding: 12rpx 16rpx 22rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top left, rgba(255, 191, 207, 0.45), transparent 28%),
    linear-gradient(180deg, #fff7fa 0%, #fff7fc 36%, #ffffff 100%);
}

.board {
  padding: 16rpx;
  background:
    radial-gradient(circle at top left, rgba(255, 208, 224, 0.28), transparent 24%),
    linear-gradient(180deg, #fffefe, #fff8fb);
}

.board-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.board-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #2f2430;
}

.board-link {
  font-size: 22rpx;
  color: #ff6f98;
  font-weight: 600;
}

.board-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #725767;
}

.board-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.board-sub {
  font-size: 18rpx;
  color: #9b7a88;
}

.board-stage {
  position: relative;
  height: 24rpx;
  margin-top: 10rpx;
}

.stage-chip {
  position: absolute;
  top: 0;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #fff;
}

.stage-chip-start {
  left: 0;
  background: linear-gradient(135deg, #8f67ff, #bb8bff);
}

.stage-chip-end {
  right: 0;
  background: linear-gradient(135deg, #ff8c78, #ff628c);
}

.board-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 6rpx;
  margin-top: 8rpx;
}

.cell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc((100% - 24rpx) / 5);
  min-height: 88rpx;
  padding: 0 1rpx;
  box-sizing: border-box;
}

.cell-node {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 66rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  box-sizing: border-box;
  box-shadow: 0 8rpx 14rpx rgba(146, 91, 122, 0.12);
}

.cell-piece {
  position: absolute;
  top: -10rpx;
  right: -2rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff5f94, #ff986b);
  color: #fff;
  font-size: 14rpx;
  line-height: 24rpx;
  text-align: center;
  box-shadow:
    0 6rpx 10rpx rgba(255, 101, 143, 0.22),
    0 0 0 4rpx rgba(255, 255, 255, 0.45);
}

.cell-badge {
  display: inline-block;
  padding: 2rpx 6rpx;
  border-radius: 999rpx;
  font-size: 12rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(120, 92, 170, 0.7);
}

.cell-step {
  margin-top: 2rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.cell-text {
  margin-top: 2rpx;
  font-size: 11rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.cell-connector {
  position: absolute;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d2a0b5;
}

.connector-arrow {
  font-size: 14rpx;
  font-weight: 700;
}

.connector-right {
  top: 50%;
  right: -6rpx;
  width: 12rpx;
  height: 8rpx;
  margin-top: -4rpx;
  background: linear-gradient(90deg, #f2c9da, #d8c2ff);
  border-radius: 999rpx;
}

.connector-right .connector-arrow {
  position: absolute;
  right: -5rpx;
  top: -6rpx;
}

.connector-left {
  top: 50%;
  left: -6rpx;
  width: 12rpx;
  height: 8rpx;
  margin-top: -4rpx;
  background: linear-gradient(90deg, #d8c2ff, #f2c9da);
  border-radius: 999rpx;
}

.connector-left .connector-arrow {
  position: absolute;
  left: -5rpx;
  top: -6rpx;
}

.connector-down {
  left: 50%;
  bottom: -11rpx;
  width: 8rpx;
  height: 14rpx;
  margin-left: -4rpx;
  background: linear-gradient(180deg, rgba(250, 219, 232, 0.96), rgba(225, 208, 255, 0.96));
  border-radius: 999rpx;
}

.connector-down .connector-arrow {
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  margin-left: -6rpx;
}

.cell-pending {
  color: #8a6676;
}

.cell-passed {
  color: #8e4d6b;
}

.cell-current {
  color: #7b2645;
}

.cell-peach .cell-node {
  background: linear-gradient(180deg, #fff2f7, #ffe4ee);
}

.cell-violet .cell-node {
  background: linear-gradient(180deg, #f7f1ff, #ebe2ff);
}

.cell-mint .cell-node {
  background: linear-gradient(180deg, #f0fff9, #dcfff0);
}

.cell-cream .cell-node {
  background: linear-gradient(180deg, #fff9ee, #ffeecc);
}

.cell-passed .cell-node {
  background: linear-gradient(180deg, #ffdce8, #ffc9de);
  border-color: rgba(255, 255, 255, 0.96);
}

.cell-current .cell-node {
  background: linear-gradient(135deg, #ff84ad, #ffbf6d);
  color: #fff;
  transform: translateY(-2rpx) scale(1.02);
  box-shadow: 0 12rpx 18rpx rgba(255, 108, 151, 0.2);
}

.cell-current .cell-badge {
  background: rgba(255, 255, 255, 0.24);
}

.cell-current .cell-step,
.cell-current .cell-text {
  color: #ffffff;
}

.actions {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
}

.dice-zone {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 10rpx 12rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff6fa, #fff0f7);
}

.dice-shell {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ff8eb0, #ffb478);
  box-shadow: 0 10rpx 18rpx rgba(255, 125, 154, 0.22);
}

.dice-shell-rolling {
  animation: dice-spin 0.55s linear infinite;
}

.dice-face {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: inset 0 4rpx 8rpx rgba(255, 150, 182, 0.18);
}

.dice-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff6d96;
  box-shadow: 0 2rpx 6rpx rgba(255, 109, 150, 0.22);
}

.dot-top-left {
  top: 12rpx;
  left: 12rpx;
}

.dot-top-right {
  top: 12rpx;
  right: 12rpx;
}

.dot-middle-left {
  top: 50%;
  left: 12rpx;
  margin-top: -5rpx;
}

.dot-middle-right {
  top: 50%;
  right: 12rpx;
  margin-top: -5rpx;
}

.dot-center {
  top: 50%;
  left: 50%;
  margin-top: -5rpx;
  margin-left: -5rpx;
}

.dot-bottom-left {
  bottom: 12rpx;
  left: 12rpx;
}

.dot-bottom-right {
  bottom: 12rpx;
  right: 12rpx;
}

.dice-info {
  flex: 1;
  min-width: 0;
}

.dice-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #38262f;
}

.dice-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  line-height: 1.45;
  color: #8d6676;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.action-btn {
  margin-bottom: 0;
}

.action-btn-half {
  flex: 1;
  width: auto;
}

.action-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 18rpx;
  line-height: 1.45;
  color: #8c6575;
}

@keyframes dice-spin {
  0% {
    transform: rotate(0deg) scale(1);
  }
  25% {
    transform: rotate(90deg) scale(1.06);
  }
  50% {
    transform: rotate(180deg) scale(0.96);
  }
  75% {
    transform: rotate(270deg) scale(1.05);
  }
  100% {
    transform: rotate(360deg) scale(1);
  }
}
