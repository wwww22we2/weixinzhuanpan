<view class="page">
  <view class="toolbar" wx:if="{{list.length}}">
    <button class="clear" size="mini" bindtap="onClear">清空</button>
  </view>

  <view wx:if="{{!list.length}}" class="empty">暂无记录</view>

  <view wx:for="{{list}}" wx:key="time" class="item card">
    <view class="time">{{item.timeText}}</view>
    <view class="body">
      <text class="tag" wx:if="{{item.type === 'food'}}">美食</text>
      <text class="tag" wx:elif="{{item.type === 'drink'}}">喝酒</text>
      <text class="tag" wx:else>自定义</text>
      <text class="res">{{item.summary}}</text>
    </view>
  </view>
</view>
