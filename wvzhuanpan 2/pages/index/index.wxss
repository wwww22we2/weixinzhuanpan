.page {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(180deg, #d1a0ff 0%, #f5edff 28%, #ffffff 52%);
}

.custom-nav {
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
}

.custom-nav-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
}

.hero {
  position: relative;
  text-align: center;
  margin-top: 88rpx;
  padding: 0 24rpx 48rpx;
}

.slogan {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #6d22c8;
  line-height: 52rpx;
}

.card-list {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 160rpx;
  box-sizing: border-box;
  padding: 0 32rpx;
  margin: 0;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 48rpx rgba(0, 0, 0, 0.05);
}

.entry-hover {
  opacity: 0.94;
}

.entry-icon-img {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  margin-right: 32rpx;
}

.entry-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 18rpx;
}

.entry-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #262227;
  line-height: 1.2;
}

.entry-desc {
  display: block;
  font-size: 28rpx;
  color: #8c8c8c;
  line-height: 1.35;
}

.entry-btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-btn-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
}

.entry-btn-purple {
  background: linear-gradient(90deg, #bf3eff 0%, #6b60ff 97.5%);
}

.entry-btn-orange {
  background: linear-gradient(180deg, #ffa930 0%, #ff4e4e 100%);
}

.entry-btn-rose {
  background: linear-gradient(180deg, #ff78a2 0%, #ff5c8a 100%);
}

.entry-btn-amber {
  background: linear-gradient(180deg, #ffb15a 0%, #ff6a3d 100%);
}

.footer-spacer {
  flex: 1;
  min-height: 48rpx;
}

.footer {
  position: relative;
  flex-shrink: 0;
  margin-top: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 48rpx;
}

.footer-pill {
  padding: 12rpx 32rpx;
  border-radius: 86rpx;
  border: 2rpx solid #9f76d0;
  font-size: 28rpx;
  font-weight: 400;
  color: #9f76d0;
  line-height: 1.4;
}

.footer-pill-hover {
  opacity: 0.85;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
