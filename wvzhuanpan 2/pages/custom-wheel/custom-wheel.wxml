<view class="page {{contentReady ? 'page-show' : 'page-hide'}}">
  <view class="wheel-box">
    <wheel-canvas
      id="wheel"
      options="{{options}}"
      colors="{{colors}}"
      rotation="{{rotation}}"
      highlighted="{{highlighted}}"
    />
    <view class="hint" wx:if="{{options.length < 2}}">请添加至少 2 个选项</view>
    <button
      class="spin-btn"
      disabled="{{options.length < 2 || spinning}}"
      bindtap="onSpin"
    >
      {{spinning ? '转动中…' : '开始转动'}}
    </button>
  </view>

  <view class="panel card">
    <view class="row">
      <input
        class="input"
        maxlength="10"
        placeholder="输入选项，最多10个字"
        value="{{draft}}"
        bindinput="onDraft"
      />
      <button
        class="add-btn"
        size="mini"
        disabled="{{options.length >= 20}}"
        bindtap="onAdd"
      >
        添加选项
      </button>
    </view>
    <view class="tip" wx:if="{{options.length >= 20}}">已达 20 个上限</view>

    <view class="list">
      <block wx:for="{{options}}" wx:key="*this">
        <view class="item">
          <text class="item-text" data-i="{{index}}" bindtap="onEdit">{{item}}</text>
          <button class="del" size="mini" data-i="{{index}}" bindtap="onDelete">删除</button>
        </view>
      </block>
    </view>

    <view class="mode-row">
      <text class="label">转动模式</text>
      <radio-group class="rg" bindchange="onModeChange">
        <label class="lbl"><radio value="single" checked="{{mode === 'single'}}" />单选项</label>
        <label class="lbl"><radio value="multi" checked="{{mode === 'multi'}}" />多选项</label>
      </radio-group>
    </view>

    <view class="mode-row" wx:if="{{mode === 'multi'}}">
      <text class="label">选中数量</text>
      <picker mode="selector" range="{{multiRange}}" value="{{multiIndex}}" bindchange="onMultiPick">
        <view class="picker-val">{{multiCount}} 个</view>
      </picker>
    </view>

    <view class="actions">
      <button class="ghost" size="mini" bindtap="onSaveTemplate">保存模板</button>
      <navigator url="/pages/history/history" class="mini-link">历史记录</navigator>
    </view>
  </view>
</view>
