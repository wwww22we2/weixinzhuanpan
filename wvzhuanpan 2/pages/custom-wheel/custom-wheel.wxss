.page {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.page-hide {
  opacity: 0;
}

.page-show {
  opacity: 1;
  transition: opacity 0.12s ease-out;
}

.wheel-box {
  text-align: center;
  margin-bottom: 24rpx;
  min-height: 620rpx;
}

.hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.spin-btn {
  margin-top: 28rpx;
  width: 420rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff;
  font-weight: 600;
}

.panel {
  padding: 28rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input {
  flex: 1;
  background: #f3f1ff;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.add-btn {
  background: #6c5ce7 !important;
  color: #fff !important;
}

.tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.list {
  margin-top: 20rpx;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.item-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: left;
}

.del {
  margin-left: 16rpx;
}

.mode-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.label {
  font-size: 26rpx;
  color: #555;
  width: 160rpx;
}

.rg {
  display: flex;
  gap: 32rpx;
}

.lbl {
  font-size: 26rpx;
  color: #333;
}

.picker-val {
  padding: 12rpx 24rpx;
  background: #f3f1ff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.actions {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.ghost {
  background: #fff !important;
  color: #6c5ce7 !important;
  border: 2rpx solid #dcd6ff !important;
}

.mini-link {
  font-size: 26rpx;
  color: #6c5ce7;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(108, 92, 231, 0.1);
}
