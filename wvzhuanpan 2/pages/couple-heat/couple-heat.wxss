.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.level-card {
  padding: 24rpx 24rpx 26rpx;
  box-shadow: 0 14rpx 36rpx rgba(255, 136, 170, 0.12);
}

.level-card-hover {
  opacity: 0.94;
}

.level-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.level-enter {
  flex-shrink: 0;
  min-width: 108rpx;
  height: 54rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 54rpx;
  text-align: center;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(255, 111, 144, 0.18);
}

.level-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2d2032;
  line-height: 1.25;
}

.level-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #715a6d;
}

.level-foot {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 22rpx;
  margin-top: 18rpx;
}

.level-foot-text {
  font-size: 24rpx;
  color: #aa7f92;
}
