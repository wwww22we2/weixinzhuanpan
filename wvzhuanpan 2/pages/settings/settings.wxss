.page {
  padding: 32rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.06);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 30rpx;
  color: #333;
}

.hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.note {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  padding: 16rpx 8rpx;
}
